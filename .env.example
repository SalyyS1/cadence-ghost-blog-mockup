# Public URL and local port
SITE_URL=http://localhost:2368
GHOST_PORT=2368
GHOST_BIND_ADDRESS=127.0.0.1
DOMAIN=blog.example.com
ACME_EMAIL=admin@example.com

# MySQL. Generate unique values before first start.
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=change-me-use-a-long-random-password
MYSQL_ROOT_PASSWORD=change-me-use-a-different-long-random-password

# Transactional SMTP. Used with compose.mail.yaml.
MAIL_TRANSPORT=Direct
MAIL_FROM=Bateson <noreply@example.com>
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=change-me
MAIL_PASSWORD=change-me

# Seed script. Create a Custom Integration in Ghost Admin to obtain the key.
GHOST_ADMIN_API_URL=http://localhost:2368
GHOST_ADMIN_API_KEY=replace-with-id:hex-secret
