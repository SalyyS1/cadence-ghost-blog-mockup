{
  "name": "bateson-ghost-publication",
  "version": "1.0.0",
  "private": true,
  "description": "Bateson sports publication theme and Ghost deployment toolkit",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "audit:runtime": "npm audit --omit=dev",
    "theme:check": "npx --yes gscan@6.6.1 ghost-theme-bateson",
    "pretheme:zip": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\"",
    "theme:zip": "cd ghost-theme-bateson && bestzip ../dist/bateson.zip *",
    "seed": "node scripts/seed-content.mjs",
    "seed:dry": "node scripts/seed-content.mjs --dry-run"
  },
  "devDependencies": {
    "bestzip": "4.0.0"
  }
}
