{{!< default}}

<main id="main-content" class="archive shell">
  {{#author}}
    <header class="archive-head author-head">
      {{#if profile_image}}<img class="author-head__image" src="{{img_url profile_image size="s"}}" alt="{{name}}">{{/if}}
      <p class="eyebrow">Author</p>
      <h1>{{name}}</h1>
      {{#if bio}}<p>{{bio}}</p>{{/if}}
      <p class="author-head__meta">{{plural ../pagination.total empty="No stories" singular="1 story" plural="% stories"}}</p>
    </header>
  {{/author}}
  <div class="archive-grid">
    {{#foreach posts}}{{> "post-card"}}{{else}}<p class="empty-state">No stories from this author yet.</p>{{/foreach}}
  </div>
  {{pagination}}
</main>
