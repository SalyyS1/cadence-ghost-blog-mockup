<article class="post-card {{post_class}}">
  <a class="post-card__media" href="{{url}}" aria-label="Read {{title}}">
    {{#if feature_image}}
      <img
        srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w"
        sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw"
        src="{{img_url feature_image size="m"}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        loading="lazy"
      >
    {{else}}
      <span class="media-placeholder" role="img" aria-label="Image placeholder"></span>
    {{/if}}
    {{#if primary_tag}}<span class="post-card__tag">{{primary_tag.name}}</span>{{/if}}
  </a>
  <h3 class="post-card__title"><a href="{{url}}">{{title}}</a></h3>
  <p class="post-card__dek">{{excerpt words="18"}}</p>
  <p class="post-card__meta">{{primary_author.name}} | {{date format="DD MMMM YYYY"}}</p>
</article>
