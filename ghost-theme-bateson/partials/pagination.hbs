<nav class="pagination" aria-label="Pagination">
  {{#if prev}}<a class="pagination__link" href="{{page_url prev}}">Newer posts</a>{{/if}}
  <span class="pagination__status">Page {{page}} of {{pages}}</span>
  {{#if next}}<a class="pagination__link" href="{{page_url next}}">Older posts</a>{{/if}}
</nav>
