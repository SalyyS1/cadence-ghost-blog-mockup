<header class="site-head">
  <div class="shell site-head__inner">
    <a class="brand" href="{{@site.url}}" aria-label="{{@site.title}} home">
      {{#if @site.logo}}
        <img class="brand__logo" src="{{@site.logo}}" alt="{{@site.title}}">
      {{else}}
        <span class="brand__word">{{@site.title}}</span>
      {{/if}}
    </a>
    <div class="head-actions">
      <button class="search-button" type="button" data-ghost-search aria-label="Search publication">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      </button>
      {{#if @member}}
        <a class="text-link" href="#/portal/account" data-portal="account">Account</a>
      {{else}}
        <a class="btn btn--small" href="#/portal/signup" data-portal="signup">Subscribe</a>
      {{/if}}
    </div>
  </div>
</header>
