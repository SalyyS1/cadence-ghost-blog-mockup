{{!< default}}

{{#post}}
<main id="main-content" class="page-main">
  <article class="page-article {{post_class}}">
    {{#if @page.show_title_and_feature_image}}
      <header class="page-hero shell">
        <p class="eyebrow">Page</p>
        <h1>{{title}}</h1>
        {{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}
        {{#if feature_image}}
          <figure class="page-hero__media">
            <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
          </figure>
        {{/if}}
      </header>
    {{/if}}
    <div class="gh-content gh-content--page">{{{content}}}</div>
  </article>
  {{> "newsletter" form_id="page-newsletter-email"}}
</main>
{{/post}}
